#!/usr/bin/env bash
#PBS -P qp00
#PBS -q hugemem
#PBS -N meraxes_pc_mpi
#PBS -l ncpus=48
#PBS -l mem=1000GB
#PBS -l walltime=20:00:00
#PBS -l jobfs=4GB
#PBS -l storage=gdata/qp00+gdata/cm25
#PBS -j oe

set -euo pipefail
: "${PC_INPUT:?Set PC_INPUT to the complete input.par to run}"
repo=${PC_REPO:-/g/data/qp00/sz4640/meraxes_photon_conservation}
build=${PC_BUILD_DIR:-$repo/build-pc-mpi}
set +u
source "${PC_ENV_FILE:-$repo/pc_env.sh}"
set -u
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
pc_default_memory=$((700000 / ((PBS_NCPUS + 47) / 48)))
for test_ranks in 1 2 4; do
    ctest --test-dir "$build" --output-on-failure --no-tests=error \
        -R "^test_photon_conservation_mpi${test_ranks}$"
done
pc_resource_args=()
if [[ -n ${PC_MAX_EDGES:-} ]]; then
    pc_resource_args+=(--max-edges "$PC_MAX_EDGES")
fi

python3 "$repo/tools/gadi_pc_run.py" \
    --input "$PC_INPUT" --input-cwd "${PC_INPUT_CWD:-$(dirname -- "$PC_INPUT")}" \
    --binary "$build/bin/meraxes" --manifest "$build/pc_build_manifest.json" \
    --run-root "${PC_RUN_ROOT:-/g/data/qp00/sz4640/pc_runs/mpi}" \
    --ranks "${PC_RANKS:-$PBS_NCPUS}" --memory-mb "${PC_MEMORY_MB:-$pc_default_memory}" \
    --debug "${PC_DEBUG:-1}" --label "${PBS_JOBID:?}" "${pc_resource_args[@]}"
