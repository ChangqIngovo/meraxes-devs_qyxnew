#!/usr/bin/env bash
#PBS -N pc_es_morphology
#PBS -P qp00
#PBS -q normal
#PBS -l ncpus=4
#PBS -l mem=16GB
#PBS -l walltime=01:00:00
#PBS -l storage=gdata/qp00+gdata/cm25
#PBS -l wd
#PBS -j oe

set -euo pipefail
: "${COMPARE_OUT:?Submit with qsub -v COMPARE_OUT=/path/to/new/results}"
PC_REPO=${PC_REPO:-/g/data/qp00/sz4640/meraxes_photon_conservation}
PC_RUN_DIR=${PC_RUN_DIR:-/g/data/qp00/sz4640/pc_runs/l10_es_hhe_f4e6c991_20261020_185914}
ES_RUN_DIR=${ES_RUN_DIR:-/g/data/qp00/sz4640/pc_runs/l10_original_es_20261020_191321}
COMPARE_PYTHON=${COMPARE_PYTHON:-/g/data/qp00/sz4640/venvs/tauefix/bin/python}

module --force purge
module load python3/3.11.7
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export MPLBACKEND=Agg PYTHONUNBUFFERED=1
"$COMPARE_PYTHON" -c 'import numpy, scipy, h5py, matplotlib'
"$COMPARE_PYTHON" "$PC_REPO/tools/es_hhe/compare_pc_es.py" \
    --pc-run "$PC_RUN_DIR" --es-run "$ES_RUN_DIR" \
    --snapshots 60 68 75 --match-xhi 0.98 0.95 0.92 \
    --match-tolerance 0.005 --slice-axis z --min-component-cells 19 \
    --output-dir "$COMPARE_OUT"
echo "Comparison output: $COMPARE_OUT"
