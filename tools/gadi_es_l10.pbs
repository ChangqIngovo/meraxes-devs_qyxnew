#!/usr/bin/env bash
#PBS -N meraxes_es_hhe_l10
#PBS -P qp00
#PBS -q hugemem
#PBS -l ncpus=32
#PBS -l mem=320GB
#PBS -l walltime=48:00:00
#PBS -l jobfs=4GB
#PBS -l storage=gdata/qp00+gdata/cm25
#PBS -l wd
#PBS -j oe

set -euo pipefail
: "${RUN_DIR:?Submit with qsub -v RUN_DIR=/path/to/prepared/run}"
: "${PBS_JOBID:?Launch this script with qsub}"
cd "$RUN_DIR"
mkdir .running || { echo 'This run was already submitted; prepare a new RUN_DIR.' >&2; exit 2; }
exec > "run_${PBS_JOBID}.log" 2>&1
echo "Job: $PBS_JOBID; start: $(date); directory: $RUN_DIR"

module --force purge
module load gcc/12.2.0 openmpi/4.1.4 fftw3/3.3.10-nci1 hdf5/1.12.2p gsl/2.7.1 python3/3.11.7
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
export OMP_WAIT_POLICY=PASSIVE
export OMP_PROC_BIND=false
unset GOMP_CPU_AFFINITY OMP_PLACES
export ES_WORKER_THREADS=${ES_WORKER_THREADS:-$PBS_NCPUS}
export ES_NATIVE_REQUIRED=1
export ES_NATIVE_LIBRARY="$RUN_DIR/solver/libes_hhe_kernels.so"
export PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
module list

es_python=$(python3 -c 'import json; print(json.load(open("run_manifest.json"))["python"])')
"$es_python" - <<'PY'
import hashlib
import json
import os
from pathlib import Path
import h5py
import numpy
import scipy

manifest = json.loads(Path('run_manifest.json').read_text())
ncpus = int(os.environ['PBS_NCPUS'])
threads = int(os.environ['ES_WORKER_THREADS'])
if ncpus < 1 or threads < 1 or threads > ncpus:
    raise RuntimeError('ES_WORKER_THREADS must be positive and no greater than PBS_NCPUS')
if int(os.environ.get('PBS_NNODES', '1')) != 1:
    raise RuntimeError('The shared-memory ES worker requires a single-node allocation')
nodefile = os.environ.get('PBS_NODEFILE')
if nodefile and len(set(Path(nodefile).read_text().split())) != 1:
    raise RuntimeError('The shared-memory ES worker requires one host in PBS_NODEFILE')
if ncpus > manifest['grid']:
    raise RuntimeError('MPI ranks must not exceed the grid slab count')
versions = {'numpy': numpy.__version__, 'scipy': scipy.__version__, 'h5py': h5py.__version__}
if versions != manifest['python_packages']:
    raise RuntimeError('Python package versions changed after preparation; prepare a new RUN_DIR')
if hashlib.sha256(Path(manifest['simulation_snapshot_list']).read_bytes()).hexdigest() != manifest['simulation_snapshot_list_sha256']:
    raise RuntimeError('Simulation a_list.txt changed after preparation')
for name, expected in manifest['files'].items():
    h = hashlib.sha256()
    with Path(name).open('rb') as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b''):
            h.update(block)
    if h.hexdigest() != expected:
        raise RuntimeError(f'Prepared file changed: {name}')
output = Path('output')
if output.exists() and any(output.iterdir()):
    raise RuntimeError('Output directory is nonempty; prepare a new RUN_DIR')
output.mkdir(exist_ok=True)
print('Commit:', manifest['commit'], flush=True)
print('Snapshots:', manifest['output_snapshots'], flush=True)
print('Python:', manifest['python'], flush=True)
print('ES worker threads:', threads, '; native kernels required', flush=True)
PY

# The adapter supplies the child with the union of these MPI rank affinities;
# parent ranks retain their core bindings throughout the galaxy calculation.
mpirun -np "$PBS_NCPUS" --bind-to core --map-by slot "$RUN_DIR/meraxes" "$RUN_DIR/input.par"
echo "Finished: $(date)"
