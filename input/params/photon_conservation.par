# Copy these overrides into a complete Meraxes input.par with the appropriate
# simulation, input tables and output paths. This fragment is not a standalone
# simulation setup. Start with a small grid and retain the Debug=2 certificate.

Flag_PhotonConservation          : 1
Flag_PatchyReion                 : 1
ReionFilterType                  : 0
ReionRtoMFilterType               : 0
PhotonConservationShape          : 1
PhotonConservationDebug          : 2
PhotonConservationRequireFull    : 0
PhotonConservationMaxEdges       : 0 # 0: no edge-count cap; the memory guard still applies
PhotonConservationMemoryMB       : 2048
PhotonConservationMaxIterations  : 10000
PhotonConservationMaxEvaluations : 1000000
PhotonConservationMaxCuts        : 512
PhotonConservationTolerance      : 1e-9

# RequireFull=1 aborts after writing diagnostics unless each source satisfies
# the configured relative full-absorption tolerance. Every residual is still
# recorded. RequireFull=0 also accepts partial geometric maxima; the unassigned
# inventory does not create a radiation-background model.
